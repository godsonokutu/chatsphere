# ==========================================================
# ChatSphere Server Environment
# Copy this file to .env and provide real values.
# NEVER commit the real .env file.
# ==========================================================

NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# ==========================================================
# DATABASE
# ==========================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatsphere_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ==========================================================
# AUTHENTICATION
# ==========================================================

# Exactly 64 hexadecimal characters
JWT_ACCESS_SECRET=replace_with_64_hex_characters

# Exactly 64 hexadecimal characters
REFRESH_TOKEN_HMAC_SECRET=replace_with_64_hex_characters

JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

JWT_ISSUER=chatsphere-api
JWT_AUDIENCE=chatsphere-client

# ==========================================================
# ACCOUNT VERIFICATION
# ==========================================================

# At least 64 characters
VERIFICATION_HMAC_SECRET=replace_with_secure_64_or_more_character_secret

# ==========================================================
# NOTIFICATION OUTBOX ENCRYPTION
# ==========================================================

OUTBOX_ENCRYPTION_KEY_VERSION=1

# Base64 value that decodes to exactly 32 bytes
OUTBOX_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# ==========================================================
# SMTP / EMAIL
# ==========================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

MAIL_FROM=ChatSphere <no-reply@example.com>

# ==========================================================
# LOGGING
# ==========================================================

LOG_LEVEL=info