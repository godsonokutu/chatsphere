# Public configuration only. Never put DB credentials, signing keys or SMTP here.
# Use the same API/server as the web client. HTTPS is required in release builds.
EXPO_PUBLIC_API_URL=https://YOUR-API-HOST.example/api

# Expo Go development only: a phone needs your computer's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
